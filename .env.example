# Per-machine settings. Copy to .env (git-ignored); docker compose reads it automatically.

# Your user and group IDs (`id -u`, `id -g`), so files the container writes are yours.
HOST_UID=1000
HOST_GID=1000

# Host Hugging Face cache, mounted into the container so weights are downloaded once.
HF_CACHE=~/.cache/huggingface

# Share of the WHOLE GPU vLLM may take (weights + KV cache). It must fit in what is free, and
# the desktop and browser already hold some of it (see `nvidia-smi`).
#   RTX 4070 SUPER 12 GB with a desktop session: 0.82 (0.85 leaves ~0.4 GB of slack)
#   RTX 5070 Ti   16 GB with a desktop session: 0.90
GPU_MEM_UTIL=0.82
MAX_MODEL_LEN=8192

# Caps on parallel sequences and on tokens per engine step; empty = vLLM's defaults. The 12B
# models (pllum, mistral_nemo) hold 7.9 GiB of weights, and with the defaults vLLM's start-up
# profiling leaves no room for the KV cache on a 12 GB card. Measured to work there:
#   GPU_MEM_UTIL=0.86 MAX_NUM_SEQS=32 MAX_NUM_BATCHED_TOKENS=2048 MAX_MODEL_LEN=2048
# (0.86 needs the desktop to hold no more than about 1 GB.) Not needed on the 16 GB card.
MAX_NUM_SEQS=
MAX_NUM_BATCHED_TOKENS=

# Only needed for gated models.
# HF_TOKEN=hf_...

# 1 = reproducible seeded sampling (batch-invariant kernels), slower. See README.
VLLM_BATCH_INVARIANT=0
