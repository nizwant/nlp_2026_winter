# Per-machine settings. Copy to .env (git-ignored); docker compose reads it automatically.

# Your user and group IDs (`id -u`, `id -g`), so files the container writes are yours.
HOST_UID=1000
HOST_GID=1000

# Host Hugging Face cache, mounted into the container so weights are downloaded once.
HF_CACHE=~/.cache/huggingface

# Share of the WHOLE GPU vLLM may take (weights + KV cache). It must fit in what is free, and
# the desktop and browser already hold some of it (see `nvidia-smi`).
#   RTX 4070 SUPER 12 GB with a desktop session: 0.85
#   RTX 5070 Ti   16 GB with a desktop session: 0.90
GPU_MEM_UTIL=0.85
MAX_MODEL_LEN=8192

# Only needed for gated models.
# HF_TOKEN=hf_...
